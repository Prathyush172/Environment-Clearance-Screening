# ==============================================================================
# Environmental Clearance Pre-Screening Service - Environment Configuration
# ==============================================================================
# This file documents all environment variables used across the system.
# Copy this file to .env and adjust values for your environment.

# === LLM PROVIDER CONFIG ===
# LLM_PROVIDER: Primary LLM backend (type: str, allowed: gemini, openai, anthropic, azure_openai, stub; default: stub)
# If unset, defaults to 'stub' (no live LLM credentials required).
LLM_PROVIDER=gemini

# LLM_MODEL_ID: Model identifier for primary provider (e.g. gemini-3-flash-preview, gemini-3.8-flash, gpt-4o)
# For Gemini, defaults to gemini-3-flash-preview.
LLM_MODEL_ID=gemini-3-flash-preview

# LLM_API_KEY: Secret API key for primary LLM provider (or GEMINI_API_KEY)
LLM_API_KEY=
GEMINI_API_KEY=

# LLM_BASE_URL: Base URL override for Azure OpenAI, Ollama, vLLM, or local endpoints (type: str, default: empty)
# If unset, uses official provider endpoints.
LLM_BASE_URL=

# === FALLBACK LLM ===
# FALLBACK_LLM_PROVIDER: Secondary provider used when primary trips circuit breaker (type: str, default: stub)
FALLBACK_LLM_PROVIDER=stub

# FALLBACK_LLM_MODEL_ID: Fallback model identifier (type: str, default: empty)
FALLBACK_LLM_MODEL_ID=

# FALLBACK_LLM_API_KEY: Fallback provider API key (type: str, default: empty)
FALLBACK_LLM_API_KEY=

# FALLBACK_LLM_BASE_URL: Fallback base URL override (type: str, default: empty)
FALLBACK_LLM_BASE_URL=

# === VERIFIER LLM ===
# VERIFIER_LLM_PROVIDER: Provider for independent verifier service (type: str, allowed: gemini, stub; default: stub)
# If unset, defaults to primary LLM_PROVIDER.
VERIFIER_LLM_PROVIDER=gemini

# VERIFIER_LLM_MODEL_ID: Model ID for verifier agent (e.g. gemini-3-flash-preview)
VERIFIER_LLM_MODEL_ID=gemini-3-flash-preview

# VERIFIER_LLM_API_KEY: API key for verifier model (type: str, default: same as LLM_API_KEY)
VERIFIER_LLM_API_KEY=

# VERIFIER_LLM_BASE_URL: Base URL override for verifier model (type: str, default: empty)
VERIFIER_LLM_BASE_URL=

# === DATABASE (POSTGRESQL) ===
# DATABASE_URL: Async PostgreSQL SQLAlchemy connection string (type: str, required)
DATABASE_URL=postgresql+asyncpg://eia_user:eia_password@postgres:5432/eia_db

# POSTGRES_USER: PostgreSQL database username (type: str, default: eia_user)
POSTGRES_USER=eia_user

# POSTGRES_PASSWORD: PostgreSQL database password (type: str, default: eia_password)
POSTGRES_PASSWORD=eia_password

# POSTGRES_DB: PostgreSQL database name (type: str, default: eia_db)
POSTGRES_DB=eia_db

# === REDIS (CELERY BROKER & CACHE) ===
# REDIS_URL: Redis connection URI for Celery broker, cache, and rate limiting (type: str, default: redis://redis:6379/0)
REDIS_URL=redis://redis:6379/0

# === CHROMA (VECTOR STORE) ===
# CHROMA_HOST: ChromaDB hostname or IP (type: str, default: chroma)
CHROMA_HOST=chroma

# CHROMA_PORT: ChromaDB HTTP port (type: int, default: 8000)
CHROMA_PORT=8000

# CHROMA_COLLECTION_NAME: Collection name for EIA corpus embeddings (type: str, default: eia_corpus)
CHROMA_COLLECTION_NAME=eia_corpus

# CHROMA_PERSIST_DIRECTORY: Local directory for persistent ChromaDB storage (type: str, default: ./data/chroma)
CHROMA_PERSIST_DIRECTORY=./data/chroma

# CHROMA_URL: Optional explicit URL override for Chroma server (e.g. http://localhost:8004)
# CHROMA_URL=

# === ADMIN & SECURITY ===
# ADMIN_TOKEN: Secret bearer token for admin operations & fault injection (type: str, min length 32 chars)
ADMIN_TOKEN=change-me-admin-token-32chars-min

# ADMIN_FAULTS_ENABLED: Feature toggle for /admin/faults endpoint (type: bool, default: false)
# If false, fault injection endpoint returns 403 Forbidden.
ADMIN_FAULTS_ENABLED=false

# === AUTHENTICATION & JWT ===
# JWT_SECRET_KEY: Secret key for signing user authentication JWT tokens (type: str, min length 32 chars)
JWT_SECRET_KEY=change-me-jwt-secret-key-32chars-min-dev-only
# JWT_ALGORITHM: Signature algorithm for JWT (default: HS256)
JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES: Session token expiration duration in minutes (default: 1440)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# === LLM STUB CONFIGURATION ===
# STUB_DELAY_MS_MIN: Minimum simulated latency in milliseconds for stub responses (type: int, default: 1500)
STUB_DELAY_MS_MIN=1500

# STUB_DELAY_MS_MAX: Maximum simulated latency in milliseconds for stub responses (type: int, default: 4000)
STUB_DELAY_MS_MAX=4000

# STUB_ERROR_RATE: Fraction of requests that deliberately return HTTP 500 (type: float 0.0-1.0, default: 0.0)
STUB_ERROR_RATE=0.0

# === AGENT LOOP BOUNDS ===
# MAX_STEPS: Maximum iterations in the agent research loop before forced termination (type: int, default: 12)
MAX_STEPS=12

# MAX_TOOL_CALLS: Maximum tool calls permitted per screening run (type: int, default: 15)
MAX_TOOL_CALLS=15

# RUN_WALL_CLOCK_SECONDS: Wall-clock timeout limit for an entire screening run (type: int, default: 90)
RUN_WALL_CLOCK_SECONDS=90

# MAX_VERIFY_ATTEMPTS: Maximum verification retry attempts before escalating (type: int, default: 2)
MAX_VERIFY_ATTEMPTS=2

# MAX_REPLANS: Maximum replanning cycles for researcher agent (type: int, default: 2)
MAX_REPLANS=2

# === GUARDRAILS ===
# GUARDRAIL_CLASSIFIER_ENABLED: Toggle for prompt injection & toxicity classifier (type: bool, default: true)
GUARDRAIL_CLASSIFIER_ENABLED=true

# TOXICITY_THRESHOLD: Confidence threshold for flagging toxic input (type: float 0.0-1.0, default: 0.8)
TOXICITY_THRESHOLD=0.8

# INJECTION_BLOCK_SEVERITY: Policy when injection detected (type: str, allowed: low, high; default: high)
# low = sanitise input and continue; high = block run immediately and quarantine
INJECTION_BLOCK_SEVERITY=high

# === RATE LIMITING ===
# RATE_LIMIT_RPM_PER_CLIENT: Allowed requests per minute per client ID (type: int, default: 60)
RATE_LIMIT_RPM_PER_CLIENT=60

# RATE_LIMIT_RPM_PER_IP: Allowed requests per minute per IP address (type: int, default: 120)
RATE_LIMIT_RPM_PER_IP=120

# MAX_CONCURRENT_RUNS_PER_CLIENT: Maximum active/running requests per client (type: int, default: 5)
MAX_CONCURRENT_RUNS_PER_CLIENT=5

# DAILY_TOKEN_BUDGET_PER_CLIENT: Daily total LLM token budget per client (type: int, default: 1000000)
DAILY_TOKEN_BUDGET_PER_CLIENT=1000000

# === CIRCUIT BREAKER ===
# BREAKER_FAILURE_THRESHOLD: Consecutive failures to trip open breaker (type: int, default: 5)
BREAKER_FAILURE_THRESHOLD=5

# BREAKER_RECOVERY_TIMEOUT_S: Cooldown window before half-open state in seconds (type: int, default: 30)
BREAKER_RECOVERY_TIMEOUT_S=30

# BREAKER_HALF_OPEN_MAX_CALLS: Allowed probe calls in half-open state (type: int, default: 2)
BREAKER_HALF_OPEN_MAX_CALLS=2

# === GATEWAY ===
# GATEWAY_TIMEOUT_S: Outbound HTTP timeout for LLM provider requests (type: int, default: 30)
GATEWAY_TIMEOUT_S=30

# GATEWAY_MAX_RETRIES: Maximum retry attempts for transient errors (type: int, default: 3)
GATEWAY_MAX_RETRIES=3

# GATEWAY_RETRY_MAX_WAIT_S: Maximum exponential backoff sleep in seconds (type: int, default: 60)
GATEWAY_RETRY_MAX_WAIT_S=60

# === VERIFIER SERVICE ===
# VERIFIER_HOST: Hostname of independent verifier microservice (type: str, default: verifier)
VERIFIER_HOST=verifier

# VERIFIER_PORT: Port of independent verifier service (type: int, default: 8001)
VERIFIER_PORT=8001

# VERIFIER_TIMEOUT_S: Timeout for calling verifier service in seconds (type: int, default: 30)
VERIFIER_TIMEOUT_S=30

# VERIFIER_URL: Optional direct URL override for Verifier service (e.g. http://localhost:8001/v1/verify)
# VERIFIER_URL=

# === FEATURE FLAGS ===
# FEATURE_MODIFIER_CHECK_ENABLED: Toggle for mandatory modifier-check step in researcher loop (type: bool, default: true)
FEATURE_MODIFIER_CHECK_ENABLED=true

# === QUALITY / EVAL ===
# QUALITY_SAMPLE_RATE: Fraction of completed runs asynchronously evaluated for quality (type: float 0.0-1.0, default: 0.1)
QUALITY_SAMPLE_RATE=0.1

# === CALLBACKS ===
# CALLBACK_HMAC_SECRET: Secret key for signing outbound webhook payloads with HMAC-SHA256 (type: str)
CALLBACK_HMAC_SECRET=change-me-hmac-secret-32chars

# === EMBEDDING & CACHING ===
# EMBEDDING_MODEL: HuggingFace sentence-transformers model name (type: str, default: all-MiniLM-L6-v2)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# EMBEDDING_CACHE_ENABLED: Enable Redis caching of text embeddings (type: bool, default: true)
EMBEDDING_CACHE_ENABLED=true

# RETRIEVAL_CACHE_ENABLED: Enable Redis caching of corpus retrieval results (type: bool, default: true)
RETRIEVAL_CACHE_ENABLED=true

# RUN_CACHE_ENABLED: Enable whole-run deduplication cache (type: bool, default: true)
RUN_CACHE_ENABLED=true

# === OBSERVABILITY ===
# OTEL_EXPORTER_OTLP_ENDPOINT: OpenTelemetry Collector gRPC/HTTP endpoint (type: str, default: http://otel-collector:4317)
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# LOG_LEVEL: Application log level (type: str, allowed: DEBUG, INFO, WARNING, ERROR; default: INFO)
LOG_LEVEL=INFO

# ENVIRONMENT: Deployment environment (type: str, allowed: development, staging, production; default: development)
ENVIRONMENT=development

# === INGEST ===
# CORPUS_DIR: Directory where EIA PDF files reside inside container or locally (type: str, default: /data/corpus)
CORPUS_DIR=/data/corpus
